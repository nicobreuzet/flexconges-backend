generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id         String    @id @default(uuid())   // identifiant non devinable, placé dans le jeton (sid)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?                        // révoquée = refusée, mais on garde la trace
  ip         String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  company    Company   @relation(fields: [companyId], references: [id])
  companyId  Int
  @@index([userId])
  @@index([companyId])
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  sector     String?
  siret      String?
  barreau    String?
  convention String?
  taille     String?
  pays       String?
  adresse    String?
  brandingConfig Json?
  roleConfig     Json?
  rulesConfig    Json?
  requireTwoFactor Boolean @default(false)
  createdAt  DateTime @default(now())

  users         User[]
  teams         Team[]
  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  holidays      Holiday[]
  auditLogs     AuditLog[]
  sessions Session[]  
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int

  users         User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  role        String    @default("employee")
  isActive    Boolean   @default(true)
  phone       String?
  team        String?
  address     String?
  startDate   DateTime?
  createdAt   DateTime  @default(now())
  resetToken        String?   @unique
  resetTokenExpires  DateTime?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  twoFactorFailedAttempts Int       @default(0)
  twoFactorLockedUntil    DateTime?

  company     Company   @relation(fields: [companyId], references: [id])
  companyId   Int
  teamId      Int?
  teamRecord  Team?    @relation(fields: [teamId], references: [id])

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  recoveryCodes RecoveryCode[]
  auditLogs     AuditLog[]
  sessions Session[]

  @@index([companyId])
}

model RecoveryCode {
  id        Int       @id @default(autoincrement())
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  userId    Int

  @@index([userId])
}

model LeaveType {
  id            Int      @id @default(autoincrement())
  code          String
  label         String
  color         String   @default("#3B82F6")
  requiresProof Boolean  @default(false)
  annualCap     Int?

  company       Company  @relation(fields: [companyId], references: [id])
  companyId     Int

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([companyId, code])
  @@index([companyId])
}

model LeaveRequest {
  id             Int       @id @default(autoincrement())
  startDate      DateTime
  endDate        DateTime
  isHalfDay      Boolean   @default(false)
  startHalf      String    @default("morning")   // 'morning' | 'afternoon'
  endHalf        String    @default("afternoon")  // 'morning' | 'afternoon'
  daysCount      Float
  status         String    @default("pending")
  comment        String?
  managerComment String?
  createdAt      DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId Int
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   Int

  @@index([companyId])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime
  label     String

  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int

  @@index([companyId])
}

model LeaveBalance {
  id        Int      @id @default(autoincrement())
  year      Int
  allocated Float
  taken     Float    @default(0)
  pending   Float    @default(0)

  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId Int
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   Int

  @@unique([userId, leaveTypeId, year])
  @@index([companyId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // ex : 'login.success', 'twofactor.enabled'
  details   Json?    // infos complémentaires (jamais de mot de passe, de code ou de secret)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?

  @@index([companyId, createdAt])
}